      "typeVersion": 1,
      "position": [
        400,
        200
      ],
      "id": "node-3"
    },
    {
      "parameters": {
        "options": {}
      },
      "name": "Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1,
      "position": [
        700,
        200
