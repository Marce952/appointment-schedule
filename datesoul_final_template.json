{
  "name": "DateSoul SaaS Appointment Manager (v6 - Final Corrected)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-cloud-datesoul-v6",
        "responseMode": "lastNode"
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        100,
        200
      ],
      "id": "webhook-node"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body;\nreturn {\n  phone: body.phone || 'unknown',\n  text: body.text || '',\n  name: body.name || 'Cliente'\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        200
      ],
      "id": "code-node"
    },
    {
      "parameters": {
        "options": {},
        "promptValues": {
          "systemPrompt": "Eres un gestor de citas para doctores y veterinarios de DateSoul. 👩‍⚕️🐾\nExtrae: Nombre Mascota/Paciente, Fecha (ISO), Hora y Nota.\nFormato de respuesta: Breve, amable y confirmando los cambios."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        600,
        200
      ],
      "id": "agent-node"
    },
    {
      "parameters": {
        "options": {
          "model": "gpt-4o-mini"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        500,
        400
      ],
      "id": "model-node"
    },
    {
      "parameters": {
        "tableName": "chat_memory_saas"
      },
      "type": "@n8n/n8n-nodes-langchain.memoryPostgresChat",
      "typeVersion": 1.3,
      "position": [
        650,
        400
      ],
      "id": "memory-node"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://localhost:3000/api/appointments?phone={{ $node[\"code-node\"].json.phone }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 2.1,
      "position": [
        800,
        400
      ],
      "id": "get-tool"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/appointments",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "PENDING"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 2.1,
      "position": [
        950,
        400
      ],
      "id": "post-tool"
    },
    {
      "parameters": {
        "message": "={{ $json.output }}",
        "phoneNumber": "={{ $node[\"code-node\"].json.phone }}"
      },
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1.1,
      "position": [
        1200,
        200
      ],
      "id": "whatsapp-node"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "update-status-datesoul-v6"
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        100,
        600
      ],
      "id": "status-webhook"
    },
    {
      "parameters": {
        "message": "=Hola! Tu cita ha sido actualizada a: {{ $json.body.status }}",
        "phoneNumber": "={{ $json.body.phone }}"
      },
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1.1,
      "position": [
        400,
        600
      ],
      "id": "notify-whatsapp"
    }
  ],
  "connections": {
    "webhook-node": {
      "main": [
        [
          {
            "node": "code-node",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "code-node": {
      "main": [
        [
          {
            "node": "agent-node",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "model-node": {
      "ai_languageModel": [
        [
          {
            "node": "agent-node",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "memory-node": {
      "ai_memory": [
        [
          {
            "node": "agent-node",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    },
    "get-tool": {
      "ai_tool": [
        [
          {
            "node": "agent-node",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "post-tool": {
      "ai_tool": [
        [
          {
            "node": "agent-node",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "agent-node": {
      "main": [
        [
          {
            "node": "whatsapp-node",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "status-webhook": {
      "main": [
        [
          {
            "node": "notify-whatsapp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}