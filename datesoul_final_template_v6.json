{
  "name": "DateSoul SaaS Appointment Manager (v6 - Connected & Complete)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-webhook-datesoul-final",
        "responseMode": "lastNode"
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "id": "webhook-main"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body;\nreturn {\n  phone: body.phone || body.from || 'unknown',\n  text: body.text || body.message || '',\n  name: body.name || 'Cliente'\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        200
      ],
      "id": "code-cleanup"
    },
    {
      "parameters": {
        "operation": "select",
        "table": {
          "mode": "name",
          "value": "Client"
        },
        "where": {
          "values": [
            {
              "column": "phone",
              "value": "={{ $node[\"code-cleanup\"].json.phone }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        400,
        200
      ],
      "id": "get-client"
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "cond-exists",
              "leftValue": "={{ $json.length }}",
              "operator": "numberGreater",
              "rightValue": 0
            }
          ]
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        600,
        200
      ],
      "id": "exists-if"
    },
    {
      "parameters": {
        "operation": "insert",
        "table": {
          "mode": "name",
          "value": "Client"
        },
        "values": {
          "values": [
            {
              "column": "name",
              "value": "={{ $node[\"code-cleanup\"].json.name }}"
            },
            {
              "column": "phone",
              "value": "={{ $node[\"code-cleanup\"].json.phone }}"
            },
            {
              "column": "businessId",
              "value": 1
            },
            {
              "column": "email",
              "value": "={{ $node[\"code-cleanup\"].json.phone + '@datesoul-saas.com' }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        800,
        400
      ],
      "id": "create-client"
    },
    {
      "parameters": {
        "options": {},
        "promptValues": {
          "systemPrompt": "=Eres un recepcionista experto. Tu prioridad es la integridad de los datos.\n\nSiempre verifica la identidad del cliente mediante su número de teléfono.\n\nAl crear una cita, asegúrate de pedir: Tipo de servicio (médico, veterinario, etc.), Fecha y Hora.\n\nSi el usuario quiere ver sus citas, muéstrale una lista numerada para que pueda elegir cuál editar o cancelar.\n\nFormato de respuesta: Breve, amable y confirmando siempre los cambios realizados.\n\nID Cliente Actual: {{ $node[\"get-client\"].json[0]?.id || $node[\"create-client\"].json.id }}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        1100,
        200
      ],
      "id": "ai-agent"
    },
    {
      "parameters": {
        "options": {
          "model": "gpt-4o-mini"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        1000,
        400
      ],
      "id": "llm-node"
    },
    {
      "parameters": {
        "tableName": "chat_memory_saas_final"
      },
      "type": "@n8n/n8n-nodes-langchain.memoryPostgresChat",
      "typeVersion": 1.3,
      "position": [
        1150,
        400
      ],
      "id": "memory-node"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://localhost:3000/api/appointments?client_id={{ $node[\"get-client\"].json[0]?.id || $node[\"create-client\"].json.id }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 2.1,
      "position": [
        1300,
        400
      ],
      "id": "tool-get"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/appointments",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "client_id",
              "value": "={{ $node[\"get-client\"].json[0]?.id || $node[\"create-client\"].json.id }}"
            },
            {
              "name": "status",
              "value": "PENDING"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 2.1,
      "position": [
        1450,
        400
      ],
      "id": "tool-post"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=http://localhost:3000/api/appointments/{{ $input.id }}",
        "sendBody": true
      },
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 2.1,
      "position": [
        1600,
        400
      ],
      "id": "tool-patch"
    },
    {
      "parameters": {
        "method": "DELETE",
        "url": "=http://localhost:3000/api/appointments/{{ $input.id }}"
      },
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 2.1,
      "position": [
        1750,
        400
      ],
      "id": "tool-delete"
    },
    {
      "parameters": {
        "message": "={{ $json.output }}",
        "phoneNumber": "={{ $node[\"code-cleanup\"].json.phone }}"
      },
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1.1,
      "position": [
        1400,
        200
      ],
      "id": "whatsapp-out"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "update-status-internal"
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        600
      ],
      "id": "status-webhook"
    },
    {
      "parameters": {
        "message": "=¡Hola {{ $json.body.clientName }}! Tu cita ha sido marcada como: {{ $json.body.status }}.",
        "phoneNumber": "={{ $json.body.phone }}"
      },
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1.1,
      "position": [
        300,
        600
      ],
      "id": "status-notify"
    }
  ],
  "connections": {
    "webhook-main": {
      "main": [
        [
          {
            "node": "code-cleanup",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "code-cleanup": {
      "main": [
        [
          {
            "node": "get-client",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "get-client": {
      "main": [
        [
          {
            "node": "exists-if",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "exists-if": {
      "main": [
        [
          {
            "node": "ai-agent",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "create-client",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "create-client": {
      "main": [
        [
          {
            "node": "ai-agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "llm-node": {
      "ai_languageModel": [
        [
          {
            "node": "ai-agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "memory-node": {
      "ai_memory": [
        [
          {
            "node": "ai-agent",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    },
    "tool-get": {
      "ai_tool": [
        [
          {
            "node": "ai-agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "tool-post": {
      "ai_tool": [
        [
          {
            "node": "ai-agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "tool-patch": {
      "ai_tool": [
        [
          {
            "node": "ai-agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "tool-delete": {
      "ai_tool": [
        [
          {
            "node": "ai-agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "ai-agent": {
      "main": [
        [
          {
            "node": "whatsapp-out",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "status-webhook": {
      "main": [
        [
          {
            "node": "status-notify",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}